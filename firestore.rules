rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection health check
    match /test/{docId} {
      allow read: if true;
    }

    // Platform general config
    match /platform_config/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Teachers profiles and availability
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if true;
    }

    // Class packages and pricing
    match /packages/{packageId} {
      allow read: if true;
      allow write: if true;
    }

    // Student bookings
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // WhatsApp reminder templates
    match /templates/{templateId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
